# CoinGecko Demo API key for local development and Vercel
COINGECKO_DEMO_API_KEY=
# Output-grant encryption key: a randomly generated secret of at least 32 bytes.
# Server-side only now — /token no longer checks a client-supplied credential,
# so this never needs to be shared with any client.
OUTPUT_ACCESS_PASSWORD=
# Used only by call-output.cjs. Set to the printed local URL or your HTTPS deployment.
API_BASE_URL=
# Optional only for local development. Omit it to select a free available port.
# LOCAL_PORT=5173
