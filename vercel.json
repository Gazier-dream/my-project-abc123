{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/markets.js": { "maxDuration": 30 },
    "api/token.js": { "maxDuration": 30 },
    "api/output.js": { "includeFiles": "data/**" }
  },
  "rewrites": [
    { "source": "/token", "destination": "/api/token" },
    { "source": "/output", "destination": "/api/output" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://coin-images.coingecko.com https://assets.coingecko.com; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
    ]
  }]
}
